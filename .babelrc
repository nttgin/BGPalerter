{
    "presets": [
        ["@babel/preset-env", {"modules": "commonjs", "targets": {"node": "22"}}]
    ],
    "plugins": [
        "@babel/plugin-transform-async-to-generator"
    ],
    "ignore": [
        "./node_modules",
        "./assets",
        "./view",
        "./tests",
        "./logs",
        "./dist",
        "./build"
    ]
}
